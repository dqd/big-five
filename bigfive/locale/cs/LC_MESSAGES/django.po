msgstr "Žena"

msgid "Male"
msgstr "Muž"

msgid "20 years old or younger"
msgstr "20 let nebo mladší"

msgid "21–40 years old"
msgstr "21–40 let"

msgid "41–60 years old"
msgstr "41–60 let"

msgid "61 years old or older"
msgstr "61 let nebo starší"

msgid "Very accurate"
msgstr "Naprosto souhlasím"

msgid "Moderately accurate"
